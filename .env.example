# Lexivo Flutter client — the ONE env file for web, Android, and iOS debug.
#
#   copy .env.example .env.development   (PowerShell)
#   cp .env.example .env.development     (bash)
#
# Then launch any target from this single file:
#   powershell -File tool\run_dev.ps1 -Target android   # emulator or USB device
#   powershell -File tool\run_dev.ps1 -Target web
#   ./tool/run_dev.sh --target ios                      # macOS only
#
# The scripts run `adb reverse` for Android, so http://localhost:8000 reaches the
# host API from emulators and USB devices alike — no per-target URL, no LAN IP.
# For an iOS *physical* device (no adb), pass -ApiHost <your-LAN-IP>.
#
# AI / OCR / R2 / JWT secrets belong in backend/.env — NOT here.
# Never commit real values. See README.md "Local environment".

ENV=development
API_BASE_URL=http://localhost:8000
APP_NAME=Lexivo Dev

# Supabase Auth (public anon/publishable key only — never the JWT secret)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Feature flags
ENABLE_LOGGING=true
ENABLE_ANALYTICS=false
ENABLE_CRASH_REPORTING=false
# Ads use Google test unit IDs while ADS_USE_PRODUCTION_IDS=false.
ENABLE_ADS=false
CHILD_DIRECTED=false
ADS_USE_PRODUCTION_IDS=false
SUBSCRIPTION_PAYWALL_ENABLED=false

# Observability (empty = no-op)
SENTRY_DSN=
POSTHOG_API_KEY=
POSTHOG_HOST=

# Client hints only — server providers are authoritative
AI_PROVIDER=gemini
OCR_PROVIDER=mistral
