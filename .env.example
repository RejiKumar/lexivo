# Lexivo Flutter client — copy to `.env` locally; never commit secrets.
# Load via --dart-define or your preferred env loader at runtime.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
API_BASE_URL=http://localhost:8000

# Observability (empty = no-op in local/CI; set via dart-define in staging/prod)
SENTRY_DSN=
POSTHOG_API_KEY=
POSTHOG_HOST=

# Subscription paywall UI (caps always enforce on API)
SUBSCRIPTION_PAYWALL_ENABLED=false

# Document scan uses device camera / photo library / file picker.
# Grant OS permissions at runtime; no secrets required for local pickers.
# See docs/document_input_source.md

# Deployment / secrets matrix: docs/deployment.md
